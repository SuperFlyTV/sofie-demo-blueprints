{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://example.com/product.schema.json",
	"title": "Studio Config",
	"type": "object",
	"properties": {
		"visionMixer": {
			"type": "object",
			"title": "VisionMixerConfig",
			"description": "Vision mixer device configuration",
			"ui:category": "Vision Mixer Device",
			"ui:title": "Vision Mixer Device Configuration",
			"properties": {
				"deviceId": {
					"type": "string",
					"description": "Vision mixer playout device ID",
					"ui:title": "Vision Mixer Device ID",
					"ui:description": "Vision Mixer Device ID (E.G. visionMixer)",
					"ui:summaryTitle": "Device"
				},
				"type": {
					"type": "string",
					"description": "Vision mixer type",
					"ui:category": "Vision Mixer",
					"ui:title": "Vision Mixer Device",
					"title": "VisionMixerDevice",
					"enum": ["Atem", "Vmix"],
					"tsEnumNames": ["Atem", "VMix"],
					"default": "Atem"
				},
				"host": {
					"type": "string",
					"description": "Host IP of the vision mixer",
					"ui:title": "Host Ip",
					"ui:description": "Host IP of the vision mixer (E.G. 0.0.0.0)",
					"default": "127.0.0.1"
				},
				"port": {
					"type": "integer",
					"description": "Port of the vision mixer",
					"ui:title": "Port",
					"ui:description": "Port of the vision mixer (E.G. 9910)",
					"default": 9910
				}
			},
			"required": ["deviceId", "type", "host", "port"],
			"additionalProperties": false
		},
		"audioMixer": {
			"type": "object",
			"title": "AudioMixerConfig",
			"description": "Audio mixer device configuration",
			"ui:category": "Sisyfos Device",
			"ui:title": "Audio Mixer Device Configuration",
			"properties": {
				"deviceId": {
					"type": "string",
					"description": "Audio mixer playout device ID",
					"ui:title": "Audio Mixer Device ID",
					"ui:description": "Audio Mixer Device ID (E.G. audioMixer)",
					"ui:summaryTitle": "Device"
				},
				"host": {
					"type": "string",
					"description": "Host IP of Sisyfos",
					"ui:title": "Host Ip",
					"ui:description": "Host IP of Sisyfos",
					"default": "127.0.0.1"
				},
				"port": {
					"type": "integer",
					"description": "Port of Sisyfos",
					"ui:title": "Port",
					"ui:description": "Port of Sisyfos (default is 1176)",
					"default": 1176
				}
			},
			"required": ["deviceId", "host", "port"],
			"additionalProperties": false
		},
		"casparcg": {
			"type": "object",
			"title": "CasparCGConfig",
			"description": "CasparCG device configuration",
			"ui:category": "CasparCG Device",
			"ui:title": "CasparCG Device Configuration",
			"properties": {
				"host": {
					"type": "string",
					"description": "Host IP of CasparCG",
					"ui:title": "Host Ip",
					"ui:description": "Host IP of CasparCG",
					"default": "127.0.0.1"
				},
				"port": {
					"type": "integer",
					"description": "Port of CasparCG",
					"ui:title": "Port",
					"ui:description": "Port of CasparCG (default is 5250)",
					"default": 5250
				}
			},
			"required": ["host", "port"],
			"additionalProperties": false
		},
		"atemSources": {
			"type": "object",
			"ui:title": "Atem Sources",
			"ui:description": "Description of Atem inputs i.e. cameras, remotes etc.",
			"ui:category": "Inputs",
			"additionalProperties": {
				"type": "object",
				"title": "InputConfig",
				"properties": {
					"input": {
						"type": "integer",
						"ui:title": "Input",
						"ui:description": "Input number on the atem, see https://atem.julusian.dev/enums#videosource",
						"ui:summaryTitle": "Input",
						"default": 1
					},
					"type": {
						"$ref": "#/$defs/SourceType"
					}
				},
				"required": ["input", "type"]
			}
		},
		"atemOutputs": {
			"type": "object",
			"ui:title": "Atem Outputs",
			"ui:description": "Description of Atem outputs / auxes",
			"ui:category": "Outputs",
			"additionalProperties": {
				"type": "object",
				"title": "OutputConfig",
				"properties": {
					"output": {
						"type": "integer",
						"ui:title": "Output",
						"ui:description": "Aux number on the atem",
						"ui:summaryTitle": "Output",
						"default": 1
					},
					"source": {
						"type": "integer",
						"ui:title": "Source",
						"ui:description": "Source number, see https://atem.julusian.dev/enums#videosource",
						"ui:summaryTitle": "Source",
						"default": 1
					}
				},
				"required": ["output", "source"]
			}
		},
		"vmixSources": {
			"type": "object",
			"ui:title": "vMix Sources",
			"ui:description": "Description of vMix inputs i.e. cameras, remotes etc.",
			"ui:category": "Inputs",
			"additionalProperties": {
				"type": "object",
				"title": "VmixInputConfig",
				"properties": {
					"input": {
						"type": "integer",
						"ui:title": "Input",
						"ui:description": "Input number for the vmix source",
						"ui:summaryTitle": "Input",
						"default": 1
					},
					"type": {
						"$ref": "#/$defs/SourceType"
					}
				},
				"required": ["input", "type"]
			}
		},
		"vmixInputs": {
			"type": "object",
			"ui:title": "vMix Input Registry",
			"ui:description": "Named vMix input registry for production newsroom layouts. Coexists with legacy vmixSources.",
			"ui:category": "Inputs",
			"default": {},
			"additionalProperties": {
				"type": "object",
				"title": "VmixRegistryInputConfig",
				"properties": {
					"input": {
						"oneOf": [{ "type": "integer" }, { "type": "string" }],
						"ui:title": "Input",
						"ui:description": "vMix input number or name",
						"ui:summaryTitle": "Input"
					},
					"role": {
						"type": "string",
						"ui:title": "Role",
						"ui:description": "Optional role identifier (e.g. camera1, lower_third)"
					},
					"overlay": {
						"type": "integer",
						"minimum": 1,
						"maximum": 4,
						"ui:title": "Overlay",
						"ui:description": "vMix overlay channel (1-4) when this input is used as an overlay"
					},
					"mix": {
						"type": "integer",
						"minimum": 1,
						"maximum": 16,
						"ui:title": "Mix",
						"ui:description": "vMix mix bus (1 = main, 2-16 = optional mix inputs)"
					},
					"loop": {
						"type": "boolean",
						"ui:title": "Loop",
						"ui:description": "Loop media input on activate"
					},
					"playOnActivate": {
						"type": "boolean",
						"ui:title": "Play On Activate",
						"ui:description": "Start playback when input is activated"
					}
				},
				"required": ["input"]
			}
		},
		"vmixControlMode": {
			"type": "string",
			"title": "VmixControlMode",
			"ui:title": "vMix Control Mode",
			"ui:description": "Demo preserves CasparCG and multiview DVE paths. Production uses registry-driven vMix layouts.",
			"ui:category": "Vision Mixer",
			"enum": ["demo", "production"],
			"tsEnumNames": ["Demo", "Production"],
			"default": "demo"
		},
		"vmixGraphicsTargets": {
			"type": "object",
			"title": "VmixGraphicsTargets",
			"ui:title": "vMix Graphics Targets",
			"ui:description": "Maps graphic types to vmixInputs registry keys for production overlay graphics.",
			"ui:category": "Graphics",
			"properties": {
				"lowerThird": {
					"type": "string",
					"ui:title": "Lower Third",
					"ui:description": "vmixInputs registry key for lower third overlay"
				},
				"headline": {
					"type": "string",
					"ui:title": "Headline",
					"ui:description": "vmixInputs registry key for headline overlay"
				},
				"bug": {
					"type": "string",
					"ui:title": "Bug",
					"ui:description": "vmixInputs registry key for bug overlay"
				},
				"logo": {
					"type": "string",
					"ui:title": "Logo",
					"ui:description": "vmixInputs registry key for logo overlay"
				},
				"strap": {
					"type": "string",
					"ui:title": "Strap",
					"ui:description": "vmixInputs registry key for strap overlay"
				},
				"ticker": {
					"type": "string",
					"ui:title": "Ticker",
					"ui:description": "vmixInputs registry key for ticker overlay"
				},
				"fullscreen": {
					"type": "string",
					"ui:title": "Fullscreen",
					"ui:description": "vmixInputs registry key for fullscreen graphics input"
				}
			},
			"additionalProperties": false
		},
		"sisyfosSources": {
			"type": "object",
			"ui:title": "Sisyfos Sources",
			"ui:description": "Description of Sisyfos channels",
			"ui:category": "Audio",
			"additionalProperties": {
				"type": "object",
				"title": "SiyfosSourceConfig",
				"properties": {
					"source": {
						"type": "integer",
						"ui:title": "Source",
						"ui:description": "Channel number of the sisyfos channel",
						"ui:summaryTitle": "Source",
						"default": 1
					},
					"type": {
						"type": "string",
						"ui:title": "Type",
						"ui:description": "Input Type",
						"ui:summaryTitle": "Type",
						"default": "host",

						"title": "AudioSourceType",
						"enum": ["host", "guest", "remote", "playback"],
						"tsEnumNames": ["Host", "Guest", "Remote", "Playback"]
					}
				},
				"required": ["source", "type"]
			}
		},
		"previewRenderer": {
			"type": "string",
			"ui:title": "Preview Renderer",
			"ui:description": "Graphics preview renderer URL",
			"ui:category": "Graphics",
			"default": ""
		},
		"casparcgLatency": {
			"type": "integer",
			"ui:title": "CasparCG Latency",
			"ui:description": "Delay in ms before SDI signal hits the mixer",
			"ui:category": "Playback",
			"min": 0
		}
	},
	"required": [
		"previewRenderer",
		"casparcgLatency",
		"sisyfosSources",
		"vmixSources",
		"atemOutputs",
		"atemSources",
		"visionMixer",
		"audioMixer",
		"casparcg"
	],
	"$defs": {
		"SourceType": {
			"title": "SourceType",
			"type": "string",
			"enum": ["camera", "remote", "mediaplayer", "graphics", "multiview"],
			"tsEnumNames": ["Camera", "Remote", "MediaPlayer", "Graphics", "MultiView"],

			"ui:title": "Type",
			"ui:description": "Input Type",
			"ui:summaryTitle": "Type",
			"default": "camera"
		}
	}
}